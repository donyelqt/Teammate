# Browser-safe environment for @teammate/web.
#
# Every variable here is bundled into the client. Nothing secret may appear in
# this file: a NEXT_PUBLIC_ prefix is what ships it to the browser, and
# src/lib/env.ts refuses to build a config that names a secret in one.

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key. Safe in the browser because RLS enforces authorization.
# A leak loses nothing an attacker could not reach with a free account.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Cloudflare Worker that serves the API.
NEXT_PUBLIC_API_URL=http://localhost:8787
