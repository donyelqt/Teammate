# Server-only environment for @teammate/api.
#
# Nothing in this file reaches a browser. The service-role key lives here and
# must never be copied into apps/web: it bypasses every RLS policy, which would
# turn an authorization boundary into a suggestion.

# Pooled Postgres connection from Cloudflare Hyperdrive.
TEAMMATE_DATABASE_URL=

# JWT secret used to verify Supabase-issued access tokens. Must match the
# Supabase project's configured secret, or every token verifies as invalid.
TEAMMATE_SUPABASE_JWT_SECRET=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
TEAMMATE_LOG_LEVEL=INFO
