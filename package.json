{
  "name": "teammate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @teammate/web dev",
    "dev:api": "cd apps/api && uv run pywrangler dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "supabase db push --link",
    "db:seed": "supabase db seed",
    "test": "pnpm --filter @teammate/web test"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
